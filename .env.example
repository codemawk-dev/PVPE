# Copie para .env.local e preencha para conectar o Supabase.
# Vazio = modo local (site usa lib/seed.ts e o painel salva no navegador).
# Project Settings → API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bucket do Storage para logos e banners (criado pelo supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_BUCKET=pvpe
